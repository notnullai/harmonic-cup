# C/C++ build
build/
build-*/
*.o
*.a
*.so
*.exe
*.obj
*.pdb

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Services
chroma/
neo4j/
.chroma/
*.db

# Generated artefacts
sim/artifacts/
# Downloaded corpora. Anchored to the repository root on purpose: an unanchored
# `datasets/` also matches `sim/datasets/`, which is the MFPT and C-MAPSS
# LOADER SOURCE, and silently kept it out of every clone. The test that imports
# it is committed, so the suite failed on any machine but the one it was
# written on — which is exactly what a clean-clone test is for.
/data/
/datasets/
*.npz
*.harmonic
!tests/golden/*.harmonic


# Secrets / local config
.env
*.local.json
tests/golden/*.csv

# Phase 4 runtime artefacts.
# (gitignore has no trailing comments: everything after the pattern, including
# the spaces and the #, is part of the pattern.)
#
# The NetworkX store, derived from kg/seed.py + kg/extracted.json by kg/load.py
kg/graph.json
# The diagnosis audit log
rag/audit/
# Local Chroma persistence
.chroma/

# Web app: dependencies and the build are regenerated by `npm ci && npm run build`.
web/node_modules/
web/dist/
web/*.tsbuildinfo
# Generated from docs/BENCHMARK.md by web/scripts/gen-benchmark.mjs (a prebuild step).
web/src/try/benchmarkContent.generated.ts

# Machines commissioned and recordings uploaded through the console.
/var/
