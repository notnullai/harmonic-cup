{
  "name": "harmonic-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Harmonic operator console: live machine health, timeline, diagnosis and reports.",
  "scripts": {
    "generate:benchmark": "node scripts/gen-benchmark.mjs",
    "predev": "npm run generate:benchmark",
    "dev": "vite",
    "prebuild": "npm run generate:benchmark",
    "build": "tsc -b && vite build",
    "pretypecheck": "npm run generate:benchmark",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^2.5.0",
    "echarts": "^6.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "svg2pdf.js": "^2.8.1"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.8",
    "@types/cytoscape-dagre": "^2.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^6.0.1"
  }
}
